# E-commerce SQL Case Study - .gitignore

# Data files (keep local, don't commit)
data/*.csv
data/raw_data/
data/processed/

# Database backups
*.backup
*.bak
*.sql.gz
*.sql.zip

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# Python related
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# SQL IDE files
*.sql~
*.sql.bak
*_backup.sql

# Logs
*.log
logs/

# OS files
.DS_Store
*.tmp
*.temp

# Analysis outputs (regenerable)
output/
results/
export/

# Personal notes
notes/
TODO.md
PERSONAL_NOTES.md

# Environment files
.env
.env.local
config.local.ini

# Credentials
*.pem
*.key
credentials.json
secrets.json
